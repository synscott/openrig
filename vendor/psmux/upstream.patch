+#[derive(Debug, PartialEq, Eq)]
+enum CheckedEntry {
+    Stop { expected: crate::checked_stop::Identity, namespace: Option<String> },
+    Observe { route: String, pane: Option<String> },
+}
+
+fn checked_entry(args: &[String]) -> io::Result<Option<CheckedEntry>> {
+    let Some(index) = process_command_index(args) else { return Ok(None) };
+    // Inspect ORIGINAL argv separators even for legacy commands that normally
+    // retain their whole line (start-server, bind-key, etc.). A checked member
+    // may never lose its list context by spawning as a child invocation.
+    let separator = |arg: &String| arg == ";" || arg == "\\;";
+    let chained = args[index..].iter().any(separator);
+    let commands: Vec<Vec<String>> = args[index..].split(separator)
+        .filter(|group| !group.is_empty()).map(|group| group.to_vec()).collect();
+    let has_check = |command: &[String]| matches!(command.first().map(String::as_str),
+        Some("kill-session" | "kill-ses" | "list-panes" | "lsp"))
+        && command.iter().skip(1).any(|a| a.starts_with('-') && a[1..].contains('G'));
+    if !commands.iter().any(|command| has_check(command)) { return Ok(None); }
+    let invalid = || io::Error::new(io::ErrorKind::InvalidInput, "checked invocation must be one explicit supported command");
+    if chained || commands.len() != 1 { return Err(invalid()); }
+    let mut namespace = None; let mut outer_target = None; let mut i = 1;
+    while i < index {
+        if i + 1 >= index { return Err(invalid()); }
+        match args[i].as_str() {
+            "-L" if namespace.is_none() => namespace = Some(args[i + 1].clone()),
+            "-t" if outer_target.is_none() => outer_target = Some(args[i + 1].clone()),
+            _ => return Err(invalid()),
+        }
+        i += 2;
+    }
+    let command = &commands[0];
+    let tail: Vec<&str> = command.iter().skip(1).map(String::as_str).collect();
+    if matches!(command[0].as_str(), "kill-session" | "kill-ses") {
+        if outer_target.is_some() { return Err(invalid()); }
+        let expected = crate::checked_stop::parse_cli(&tail).ok_or_else(invalid)?;
+        return Ok(Some(CheckedEntry::Stop { expected, namespace }));
+    }
+    // -G observation is fixed-format, one named server, no filters/shell/
+    // all-session enumeration or arbitrary global/config/socket options.
+    let mut guarded = false; let mut target = None; let mut i = 0;
+    while i < tail.len() {
+        match tail[i] {
+            "-G" if !guarded => guarded = true,
+            "-t" if target.is_none() && i + 1 < tail.len() => { i += 1; target = Some(tail[i]); },
+            _ => return Err(invalid()),
+        }
+        i += 1;
+    }
+    if !guarded { return Err(invalid()); }
+    let target = target.ok_or_else(invalid)?;
+    let named = if let Some(outer) = outer_target.as_deref() {
+        let local = target.strip_prefix('%').ok_or_else(invalid)?;
+        if local.is_empty() || !local.bytes().all(|b| b.is_ascii_digit()) { return Err(invalid()); }
+        outer
+    } else { target };
+    let name = named.strip_prefix('=').ok_or_else(invalid)?;
+    let name = name.strip_suffix(':').unwrap_or(name);
+    if name.is_empty() || name.chars().any(|c| matches!(c, ':' | '\n' | '\r' | '\0')) { return Err(invalid()); }
+    Ok(Some(CheckedEntry::Observe {
+        route: crate::session::namespaced_session_base(namespace.as_deref(), name),
+        pane: outer_target.as_ref().map(|_| target.to_string()),
+    }))
+}
+
+// Both real CLI entry and source regression tests pass through this decision.
+// The legacy continuation owns ALL old child-list/maintenance/routing effects.
+fn dispatch_cli_entry(args: &[String], checked: impl FnOnce(CheckedEntry) -> io::Result<()>,
+    legacy: impl FnOnce() -> io::Result<()>) -> io::Result<()>
+{
+    match checked_entry(args)? { Some(plan) => checked(plan), None => legacy() }
+}
+
+fn execute_checked_entry(plan: CheckedEntry) -> io::Result<()> {
+    match plan {
+        CheckedEntry::Stop { expected, namespace } => {
+            let resolved = crate::session::resolve_session_by_id(expected.sid)
+                .ok_or_else(|| io::Error::new(io::ErrorKind::NotFound, "checked stop route unavailable"))?;
+            let route = crate::session::namespaced_session_base(namespace.as_deref(), &resolved);
+            crate::checked_stop::send(&route, expected)?;
+            println!("CHECKED-STOP COMPLETE");
+        }
+        CheckedEntry::Observe { route, pane } => print!("{}", crate::checked_stop::observe(&route, pane.as_deref())?),
+    }
+    Ok(())
+}
