+#[test]
+fn schema_refuses_duplicate_extra_and_wrong_types() {
+    let good = serde_json::to_string(&request()).unwrap();
+    assert!(decode(good.as_bytes()).is_ok());
+    for bad in [good.replacen("\"version\":1", "\"version\":1,\"version\":1", 1), good.replacen("\"version\":1", "\"version\":1,\"extra\":true", 1), good.replacen("\"version\":1", "\"version\":\"1\"", 1), good.replacen("\"env\":{}", "\"env\":{\"X\":\"1\",\"X\":\"2\"}", 1)] {
+        assert!(decode(bad.as_bytes()).is_err());
+    }
+}
+
+#[test]
+fn reserved_controls_refuse_assignments_and_removals() {
+    for key in ["PSMUX_DATA_DIR", "psmux_config_file", "PSMUX_CHECKED_CREATE", "SystemRoot"] {
+        let mut r=request(); r.env.insert(key.into(), "value".into()); assert!(validate(&r).is_err());
+        let mut r=request(); r.unset.push(key.into()); assert!(validate(&r).is_err());
+    }
+    let mut r=request(); r.unset.push("CLAUDE_CODE_SESSION_ID".into()); r.env.insert("OPENRIG_NODE_ID".into(), "literal".into()); assert!(validate(&r).is_ok());
+}
+
+#[test]
+fn managed_names_attempts_and_environment_are_bounded() {
+    for name in ["", "MixedCase", "../seat", "a/b", "__warm__", "x:y", "x\n"] {
+        let mut r=request(); r.name=name.into(); assert!(validate(&r).is_err());
+    }
+    let mut r=request(); r.attempt="not-a-uuid".into(); assert!(validate(&r).is_err());
+    let mut r=request(); r.env.insert("X".into(), "a\0b".into()); assert!(validate(&r).is_err());
+    let mut r=request(); r.unset=vec!["Path".into(), "PATH".into()]; assert!(validate(&r).is_err());
+    let mut r=request(); r.cwd="relative".into(); assert!(validate(&r).is_err());
+    assert!(decode(&vec![b' ';MAX_REQUEST+1]).is_err());
+}
+
+#[test]
+fn original_spawn_and_nonce_are_required_for_created_receipt() {
+    let r=request(); let original=SpawnIdentity{pid:123,birth:456};
+    let mut ready=Ready{version:1,status:"created".into(),attempt:r.attempt.clone(),name:r.name.clone(),root:"root".into(),pid:"123".into(),birth:"456".into(),sid:Some("7".into()),pane:Some("%1".into())};
+    assert!(qualify(&r,"root",&original,&ready).is_ok());
+    for field in 0..6 {
+        let mut wrong=ready.clone(); match field { 0=>wrong.attempt="other".into(),1=>wrong.name="sibling".into(),2=>wrong.root="other-root".into(),3=>wrong.pid="124".into(),4=>wrong.birth="457".into(),_=>wrong.pane=Some("%bad".into()) }
+        assert!(qualify(&r,"root",&original,&wrong).is_err());
+    }
+    ready.status="collision".into(); assert!(qualify(&r,"root",&original,&ready).is_err());
+    ready.sid=None;ready.pane=None;assert!(qualify(&r,"root",&original,&ready).is_ok());
+    ready.status="unknown".into(); assert!(qualify(&r,"root",&original,&ready).is_err());
+}
+
+#[test]
+fn lock_outcomes_do_not_turn_abandoned_or_failed_into_absence() {
+    assert_eq!(strict_lock_decision(0),LockDecision::Owned);
+    assert_eq!(strict_lock_decision(0x102),LockDecision::Collision);
+    for code in [0x80,0xffffffff,1] { assert_eq!(strict_lock_decision(code),LockDecision::Unknown); }
+}
+
+#[test]
+fn result_protocol_never_contains_environment_or_error_details() {
+    let mut r=request();r.env.insert("PRIVATE_VALUE".into(),"do-not-emit".into());
+    for result in [Outcome::Unknown(None),Outcome::Unknown(Some(SpawnIdentity{pid:123,birth:456})),Outcome::Collision,Outcome::Created{sid:"7".into(),pid:"123".into(),birth:"456".into(),pane:"%1".into()}] {
+        let value=result.output(&r);assert!(!value.to_string().contains("do-not-emit"));assert!(!value.to_string().contains("PRIVATE_VALUE"));assert_eq!(value["attempt"],r.attempt);
