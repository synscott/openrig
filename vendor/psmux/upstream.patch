+//! Scoped managed cold creation. No absence inference, warm claim or name cleanup.
+use std::{collections::{BTreeMap,HashSet},io::{self,Read,Write},path::{Path,PathBuf},time::{Duration,Instant}};
+use serde::{Serialize,Deserialize};
+pub(crate) const MAX_REQUEST:usize=1024*1024;
+fn invalid()->io::Error{io::Error::new(io::ErrorKind::InvalidInput,"checked creation unknown")}
+
+fn unique_env<'de,D:serde::Deserializer<'de>>(d:D)->Result<BTreeMap<String,String>,D::Error>{
+ struct Visitor;
+ impl<'de> serde::de::Visitor<'de> for Visitor{
+  type Value=BTreeMap<String,String>;
+  fn expecting(&self,f:&mut std::fmt::Formatter)->std::fmt::Result{f.write_str("unique environment map")}
+  fn visit_map<M:serde::de::MapAccess<'de>>(self,mut m:M)->Result<Self::Value,M::Error>{
+   let mut map=BTreeMap::new();let mut keys=HashSet::new();
+   while let Some((key,value))=m.next_entry::<String,String>()?{
+    if !keys.insert(key.to_ascii_lowercase()){return Err(serde::de::Error::custom("duplicate environment name"))}
+    map.insert(key,value);
+   }Ok(map)
+  }
+ }d.deserialize_map(Visitor)
+}
+#[derive(Debug,Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Request{pub version:u8,pub attempt:String,pub name:String,pub cwd:String,#[serde(deserialize_with="unique_env")]pub env:BTreeMap<String,String>,pub unset:Vec<String>}
+fn component(s:&str)->bool{!s.is_empty()&&s.len()<=128&&s.as_bytes()[0].is_ascii_alphanumeric()&&s.bytes().all(|b|b.is_ascii_lowercase()||b.is_ascii_digit()||b"_.@-".contains(&b))}
+fn uuid(s:&str)->bool{s.len()==36&&s.bytes().enumerate().all(|(i,b)|if [8,13,18,23].contains(&i){b==b'-'}else{b.is_ascii_digit()||(b'a'..=b'f').contains(&b)})&&s.as_bytes()[14]==b'4'&&b"89ab".contains(&s.as_bytes()[19])}
+fn reserved(s:&str)->bool{let s=s.to_ascii_uppercase();s.starts_with("PSMUX_")||["SYSTEMROOT","WINDIR","COMSPEC"].contains(&s.as_str())}
+fn env_name(s:&str)->bool{!s.is_empty()&&!s.contains(['=','\0'])&&s.len()<=32767}
+pub(crate) fn validate(r:&Request)->io::Result<()>{
+ if r.version!=1||!uuid(&r.attempt)||!component(&r.name)||!Path::new(&r.cwd).is_absolute()||!Path::new(&r.cwd).is_dir()||r.env.len()>4096||r.unset.len()>4096{return Err(invalid())}
+ let mut keys=HashSet::new();
+ for (key,value) in &r.env{if !env_name(key)||reserved(key)||value.contains('\0')||!keys.insert(key.to_ascii_lowercase()){return Err(invalid())}}
+ keys.clear();for key in &r.unset{if !env_name(key)||reserved(key)||!keys.insert(key.to_ascii_lowercase()){return Err(invalid())}}
+ if serde_json::to_vec(r).map_err(|_|invalid())?.len()>MAX_REQUEST{return Err(invalid())}Ok(())
+}
+pub(crate) fn decode(bytes:&[u8])->io::Result<Request>{if bytes.len()>MAX_REQUEST{return Err(invalid())}let r=serde_json::from_slice(bytes).map_err(|_|invalid())?;validate(&r)?;Ok(r)}
+fn read_request(path:&Path)->io::Result<(Request,Vec<u8>)>{
+ no_redirect(path)?;if !std::fs::metadata(path)?.is_file(){return Err(invalid())}let mut bytes=Vec::new();std::fs::File::open(path)?.take(MAX_REQUEST as u64+1).read_to_end(&mut bytes)?;Ok((decode(&bytes)?,bytes))
+}
+fn no_redirect(path:&Path)->io::Result<()>{
+ if !path.is_absolute(){return Err(invalid())}
+ for part in path.ancestors(){let m=std::fs::symlink_metadata(part)?;if m.file_type().is_symlink(){return Err(invalid())}
+  #[cfg(windows)]{use std::os::windows::fs::MetadataExt;if m.file_attributes()&0x400!=0{return Err(invalid())}}
+ }Ok(())
+}
+fn path_key(path:&Path)->String{let s=path.to_string_lossy();let s=s.strip_prefix(r"\\?\").unwrap_or(&s);if cfg!(windows){s.replace('\\',"/").trim_end_matches('/').to_lowercase()}else{s.to_string()}}
+fn root()->io::Result<(PathBuf,String)>{let path=PathBuf::from(std::env::var_os("PSMUX_DATA_DIR").ok_or_else(invalid)?);no_redirect(&path)?;if !path.is_dir(){return Err(invalid())}let canonical=path.canonicalize()?;if path_key(&canonical)!=path_key(&path){return Err(invalid())}let key=path_key(&canonical);Ok((canonical,key))}
+
+#[derive(Clone,Debug,PartialEq,Eq)]pub(crate) struct SpawnIdentity{pub pid:u32,pub birth:u64}
+#[derive(Clone,Debug,Serialize,Deserialize)]#[serde(deny_unknown_fields)]
+pub(crate) struct Ready{pub version:u8,pub status:String,pub attempt:String,pub name:String,pub root:String,pub pid:String,pub birth:String,pub sid:Option<String>,pub pane:Option<String>}
+fn decimal(s:&str)->bool{!s.is_empty()&&s.bytes().all(|b|b.is_ascii_digit())}
+pub(crate) fn qualify(r:&Request,root:&str,spawn:&SpawnIdentity,ready:&Ready)->io::Result<()>{
+ if ready.version!=1||ready.attempt!=r.attempt||ready.name!=r.name||ready.root!=root||ready.pid!=spawn.pid.to_string()||ready.birth!=spawn.birth.to_string()||spawn.pid==0||spawn.birth==0{return Err(invalid())}
+ match ready.status.as_str(){
+ "created"=>{if !ready.sid.as_deref().is_some_and(decimal)||!ready.pane.as_deref().and_then(|p|p.strip_prefix('%')).is_some_and(decimal){return Err(invalid())}},
+ "collision"=>{if ready.sid.is_some()||ready.pane.is_some(){return Err(invalid())}},
+ _=>return Err(invalid())}Ok(())
+}
+pub(crate) enum Outcome{Created{sid:String,pid:String,birth:String,pane:String},Collision,Unknown(Option<SpawnIdentity>)}
+impl Outcome{
+ fn code(&self)->i32{match self{Self::Created{..}=>0,Self::Collision=>2,Self::Unknown(_)=>3}}
+ pub(crate) fn output(&self,r:&Request)->serde_json::Value{match self{
+ Self::Created{sid,pid,birth,pane}=>serde_json::json!({"version":1,"status":"created","attempt":r.attempt,"name":r.name,"sid":sid,"pid":pid,"birth":birth,"pane":pane}),
+ Self::Collision=>serde_json::json!({"version":1,"status":"collision","attempt":r.attempt,"name":r.name}),
+ Self::Unknown(spawn)=>serde_json::json!({"version":1,"status":"unknown","attempt":r.attempt,"name":r.name,"pid":spawn.as_ref().map(|s|s.pid.to_string()),"birth":spawn.as_ref().map(|s|s.birth.to_string())})}}
+}
+#[derive(Debug,PartialEq,Eq)]pub(crate) enum LockDecision{Owned,Collision,Unknown}
+pub(crate) fn strict_lock_decision(code:u32)->LockDecision{match code{0=>LockDecision::Owned,0x102=>LockDecision::Collision,_=>LockDecision::Unknown}}
+
+// Consistency checksum for a trusted, exclusively staged request, not a MAC or
+// authentication boundary. Actor receipt ownership uses original OS spawn identity.
+fn checksum(bytes:&[u8])->String{use std::hash::{Hash,Hasher};let mut h=std::collections::hash_map::DefaultHasher::new();bytes.hash(&mut h);format!("{:016x}",h.finish())}
+fn attempt_dir(root:&Path,r:&Request)->PathBuf{root.join("openrig-create-attempts").join(&r.attempt)}
+fn write_ready(path:&Path,ready:&Ready)->io::Result<()>{
+ let parent=path.parent().ok_or_else(invalid)?;no_redirect(parent)?;
+ if std::fs::symlink_metadata(path).is_ok(){return Err(invalid())}
+ let pending=parent.join("ready.pending");let mut f=std::fs::OpenOptions::new().write(true).create_new(true).open(&pending)?;
+ serde_json::to_writer(&mut f,ready).map_err(|_|invalid())?;f.write_all(b"\n")?;f.sync_all()?;drop(f);std::fs::rename(pending,path)
+}
+fn apply_environment(r:&Request){for key in &r.unset{std::env::remove_var(key)}for(key,value)in &r.env{std::env::set_var(key,value)}}
+pub(crate) struct Context{pub request:Request,pub root:String,pub receipt:PathBuf}
+impl Context{
+ pub(crate) fn ready(&self,app:&crate::types::AppState)->io::Result<()>{
+  let id=crate::checked_stop::Identity::own(app.session_id).ok_or_else(invalid)?;
+  let window=app.windows.first().ok_or_else(invalid)?;let pane=crate::tree::get_active_pane_id(&window.root,&window.active_path).ok_or_else(invalid)?;
+  write_ready(&self.receipt,&Ready{version:1,status:"created".into(),attempt:self.request.attempt.clone(),name:self.request.name.clone(),root:self.root.clone(),pid:id.pid.to_string(),birth:id.birth.to_string(),sid:Some(id.sid.to_string()),pane:Some(format!("%{pane}"))})
+ }
+}
+pub(crate) fn child(file:&Path,wanted:&str,receipt:&Path,namespace:Option<String>)->io::Result<()>{
+ let(r,bytes)=read_request(file)?;if checksum(&bytes)!=wanted{return Err(invalid())}if namespace.as_deref().is_some_and(|n|!component(n)){return Err(invalid())}
+ let(root_path,root_key)=root()?;if receipt!=attempt_dir(&root_path,&r).join("ready.json"){return Err(invalid())}no_redirect(receipt.parent().ok_or_else(invalid)?)?;
+ let base=crate::session::namespaced_session_base(namespace.as_deref(),&r.name);
+ let guard=match crate::platform::acquire_checked_session_mutex(&base){
+  Ok(g)=>g,
+  Err(LockDecision::Collision)=>{let pid=std::process::id();let birth=crate::platform::process_kill::process_creation_time(pid).filter(|b|*b!=0).ok_or_else(invalid)?;return write_ready(receipt,&Ready{version:1,status:"collision".into(),attempt:r.attempt,name:r.name,root:root_key,pid:pid.to_string(),birth:birth.to_string(),sid:None,pane:None})},
+  Err(_)=>return Err(invalid())};
+ // Existing registry of any kind is unresolved, never stale-pruned by creation.
+ for path in [crate::paths::port_file(&base),crate::paths::key_file(&base),crate::paths::sid_file(&base),crate::paths::pid_file(&base)]{
+  match std::fs::symlink_metadata(path){Err(e)if e.kind()==io::ErrorKind::NotFound=>{},_=>return Err(invalid())}
+ }
+ apply_environment(&r);std::env::set_var("PSMUX_NO_WARM","1");
+ let name=r.name.clone();let cwd=r.cwd.clone();let context=Context{request:r,root:root_key,receipt:receipt.into()};
+ crate::server::run_managed_server(name,namespace,cwd,guard,context)
+}
+pub(crate) fn run(file:&Path,namespace:Option<String>)->i32{
+ let start=Instant::now();let Ok((r,bytes))=read_request(file)else{return 3};let mut original=None;
+ let result=(||->io::Result<Outcome>{
+  if namespace.as_deref().is_some_and(|n|!component(n)){return Err(invalid())}
+  let(root_path,root_key)=root()?;let attempts=root_path.join("openrig-create-attempts");
+  match std::fs::create_dir(&attempts){Ok(())=>{},Err(e)if e.kind()==io::ErrorKind::AlreadyExists=>{},Err(e)=>return Err(e)}no_redirect(&attempts)?;
+  let dir=attempt_dir(&root_path,&r);std::fs::create_dir(&dir)?;no_redirect(&dir)?;let receipt=dir.join("ready.json");
+  let mut args=vec!["checked-create-server".into(),"--file".into(),file.to_string_lossy().into_owned(),"--checksum".into(),checksum(&bytes),"--receipt".into(),receipt.to_string_lossy().into_owned()];
+  if let Some(ns)=&namespace{args.splice(0..0,["-L".into(),ns.clone()]);}
+  apply_environment(&r);
+  let spawned=crate::platform::spawn_checked_server_hidden(&std::env::current_exe()?,&args)?;
+  let identity=SpawnIdentity{pid:spawned.pid,birth:spawned.birth};original=Some(identity.clone());
+  while start.elapsed()<Duration::from_secs(30){
+   if receipt.exists(){no_redirect(&receipt)?;let mut data=Vec::new();std::fs::File::open(&receipt)?.take(4097).read_to_end(&mut data)?;if data.len()>4096{return Err(invalid())}let ready:Ready=serde_json::from_slice(&data).map_err(|_|invalid())?;qualify(&r,&root_key,&identity,&ready)?;
+    return if ready.status=="collision"{Ok(Outcome::Collision)}else{Ok(Outcome::Created{sid:ready.sid.ok_or_else(invalid)?,pid:ready.pid,birth:ready.birth,pane:ready.pane.ok_or_else(invalid)?})}
+   }std::thread::sleep(Duration::from_millis(10));
+  }Err(invalid())
+ })();
+ let outcome=result.unwrap_or(Outcome::Unknown(original));let code=outcome.code();println!("{}",outcome.output(&r));let _=io::stdout().flush();code
+}
+#[cfg(test)]#[path="../tests-rs/test_checked_create.rs"]mod tests;
