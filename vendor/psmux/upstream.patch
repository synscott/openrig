+//! Checked, own-session logical teardown. No registry identity or name fallback.
+//! OpenRig qualification candidate against psmux 20aa1d7, upstream MIT retained.
+use std::io::{self, Read, Write};
+use std::time::Duration;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Identity { pub sid: usize, pub pid: u32, pub birth: u64 }
+
+impl Identity {
+    pub fn parse(sid: &str, pid: &str, birth: &str) -> Option<Self> {
+        fn decimal(s: &str) -> bool { !s.is_empty() && s.bytes().all(|b| b.is_ascii_digit()) }
+        if !decimal(sid) || !decimal(pid) || !decimal(birth) { return None; }
+        let value = Self { sid: sid.parse().ok()?, pid: pid.parse().ok()?, birth: birth.parse().ok()? };
+        (value.pid != 0 && value.birth != 0).then_some(value)
+    }
+    pub fn own(sid: usize) -> Option<Self> {
+        let pid = std::process::id();
+        let birth = crate::platform::process_kill::process_creation_time(pid)?;
+        (birth != 0).then_some(Self { sid, pid, birth })
+    }
+}
+
+/// Parse the original outer CLI tail, before routing strips/replaces -t.
+pub(crate) fn parse_cli(tail: &[&str]) -> Option<Identity> {
+    if tail.len() != 4 { return None; }
+    let mut sid = None; let mut guard = None;
+    for pair in tail.chunks_exact(2) {
+        match pair[0] {
+            "-t" if sid.is_none() => sid = pair[1].strip_prefix('$'),
+            "-G" if guard.is_none() => guard = Some(pair[1]),
+            _ => return None,
+        }
+    }
+    let (pid, birth) = guard?.split_once(':')?;
+    Identity::parse(sid?, pid, birth)
+}
+
+pub(crate) const PANE_FORMAT: &str = "#{session_name}|#{session_id}|#{server_pid}|#{server_birth}|#{pane_id}|#{pane_index}|#{pane_current_path}|#{pane_width}|#{pane_height}|#{pane_active}";
+
+pub(crate) fn read_observation(reader: &mut impl Read) -> io::Result<String> {
+    let mut bytes = Vec::new();
+    reader.take(crate::session::MAX_AUTHED_RESPONSE_BYTES + 1).read_to_end(&mut bytes)?;
+    if bytes.len() >= crate::session::MAX_AUTHED_RESPONSE_BYTES as usize {
+        return Err(io::Error::new(io::ErrorKind::InvalidData, "checked observation exceeds bound"));
+    }
+    let bytes = bytes.strip_prefix(b"OK\n")
+        .filter(|body| body.ends_with(b"\n") && !body.starts_with(b"ERROR:"))
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidData, "checked observation unknown"))?;
+    String::from_utf8(bytes.to_vec()).map_err(|_| io::Error::new(io::ErrorKind::InvalidData, "invalid checked observation"))
+}
+
+pub(crate) fn observe(route: &str, pane: Option<&str>) -> io::Result<String> {
+    let port = std::fs::read_to_string(crate::paths::port_file(route))?.trim().parse::<u16>()
+        .map_err(|_| io::Error::new(io::ErrorKind::InvalidData, "invalid checked observation route"))?;
+    let key = crate::session::read_session_key(route)?;
+    let mut stream = crate::session::open_authed_checked(&format!("127.0.0.1:{}", port), &key,
+        b"list-panes-checked\n", Duration::from_secs(1), Duration::from_secs(3))
+        .ok_or_else(|| io::Error::new(io::ErrorKind::Other, "checked observation transport unknown"))?;
+    let observation = read_observation(&mut stream)?;
+    // A scoped local pane remains an existence requirement, never a global
+    // selector. Return all own panes so the sole-pane guard stays conservative.
+    if let Some(pane) = pane {
+        if !observation.lines().any(|line| line.split('|').nth(4) == Some(pane)) {
+            return Err(io::Error::new(io::ErrorKind::NotFound, "checked observation pane unavailable"));
+        }
+    }
+    Ok(observation)
+}
+
+pub(crate) const COMPLETE: &[u8] = b"CHECKED-STOP COMPLETE\n";
+pub(crate) const REJECTED: &[u8] = b"CHECKED-STOP REJECTED\n";
+
+// Runs in the main actor. Teardown is called directly here, never enqueued.
+// The injected effect is the existing own teardown in production; tests observe
+// zero effects on every rejection and completion only AFTER that effect returns.
+pub(crate) fn perform<W: Write>(expected: Identity, actual: Option<Identity>, writer: &mut W,
+    teardown: impl FnOnce()) -> io::Result<bool>
+{
+    if actual != Some(expected) {
+        writer.write_all(REJECTED)?;
+        writer.flush()?;
+        return Ok(false);
+    }
+    teardown();
+    writer.write_all(COMPLETE)?;
+    writer.flush()?;
+    Ok(true)
+}
+
+pub(crate) fn read_result(reader: &mut impl Read) -> io::Result<()> {
+    let mut bytes = Vec::new();
+    // Require AUTH + exact result + EOF. Propagate ALL read errors, including
+    // reset after partial data; an enqueue ACK/auth ACK can never be success.
+    reader.take(65).read_to_end(&mut bytes)?;
+    if bytes == [b"OK\n".as_slice(), COMPLETE].concat() { return Ok(()); }
+    if bytes == [b"OK\n".as_slice(), REJECTED].concat() {
+        return Err(io::Error::new(io::ErrorKind::PermissionDenied, "checked stop identity rejected"));
+    }
+    Err(io::Error::new(io::ErrorKind::InvalidData, "checked stop completion unknown"))
+}
+
+pub(crate) fn send(route: &str, expected: Identity) -> io::Result<()> {
+    // Route is a hint resolved ONCE. No warm/default resolution, retry, probe,
+    // stale registry removal, TARGET forwarding, or second connection.
+    let port = std::fs::read_to_string(crate::paths::port_file(route))?.trim().parse::<u16>()
+        .map_err(|_| io::Error::new(io::ErrorKind::InvalidData, "invalid checked stop route"))?;
+    let key = crate::session::read_session_key(route)?;
+    let command = format!("kill-session-checked {} {} {}\n", expected.sid, expected.pid, expected.birth);
+    let mut stream = crate::session::open_authed_checked(&format!("127.0.0.1:{}", port),
+        &key, command.as_bytes(), Duration::from_secs(1), Duration::from_secs(3))
+        .ok_or_else(|| io::Error::new(io::ErrorKind::Other, "checked stop transport unknown"))?;
+    read_result(&mut stream)
+}
