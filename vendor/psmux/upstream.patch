@@ -0,0 +1,156 @@
+//! OpenRig checked input v1. Same actor + original pane writer, never PID injection.
+//! Derived from psmux 20aa1d7; upstream MIT attribution retained.
+use std::io::{self,Read,Write};
+use std::path::PathBuf;
+use std::time::Duration;
+use base64::Engine;
+use crate::checked_stop::Identity;
+
+pub(crate) const CAPABILITIES:&str="OPENRIG-PSMUX 1 checked-input-v1 checked-create-v1 checked-stop-v1 observe-v1 lazy-session\n";
+pub(crate) const COMPLETE:&[u8]=b"CHECKED-INPUT COMPLETE\n";
+pub(crate) const REJECTED:&[u8]=b"CHECKED-INPUT REJECTED\n";
+pub(crate) const UNKNOWN:&[u8]=b"CHECKED-INPUT UNKNOWN\n";
+pub(crate) const MAX_FILE:usize=1024*1024;
+pub(crate) const MAX_ENCODED:usize=16*1024*1024;
+pub(crate) const MAX_WIRE:usize=8*1024*1024+4096;
+fn invalid()->io::Error{io::Error::new(io::ErrorKind::InvalidInput,"checked input invalid")}
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub(crate) enum Mode{Raw,Bracketed,Codex,CodexClear,CopyCancel,Keys,Auto}
+impl Mode{
+ fn parse(s:&str)->Option<Self>{Some(match s{"raw"=>Self::Raw,"bracketed"=>Self::Bracketed,"codex"=>Self::Codex,"codex-clear"=>Self::CodexClear,"copy-cancel"=>Self::CopyCancel,"keys"=>Self::Keys,"auto"=>Self::Auto,_=>return None})}
+ fn name(self)->&'static str{match self{Self::Raw=>"raw",Self::Bracketed=>"bracketed",Self::Codex=>"codex",Self::CodexClear=>"codex-clear",Self::CopyCancel=>"copy-cancel",Self::Keys=>"keys",Self::Auto=>"auto"}}
+}
+#[derive(Clone,Debug,PartialEq,Eq)]
+pub(crate) enum Payload{Text(String),Keys(Vec<String>),None}
+#[derive(Clone,Debug,PartialEq,Eq)]
+pub(crate) struct Request{pub expected:Identity,pub pane:usize,pub mode:Mode,pub payload:Payload}
+#[derive(Debug,PartialEq,Eq)]
+pub(crate) struct Invocation{pub expected:Identity,pub pane:usize,pub mode:Mode,pub file:Option<PathBuf>}
+fn pane_id(s:&str)->Option<usize>{let n=s.strip_prefix('%')?;if n.is_empty()||!n.bytes().all(|b|b.is_ascii_digit()){return None}n.parse().ok()}
+pub(crate) fn parse_cli(tail:&[&str])->Option<Invocation>{
+ if tail.len()%2!=0{return None}
+ let(mut sid,mut server,mut pane,mut mode,mut file)=(None,None,None,None,None);
+ for pair in tail.chunks_exact(2){match pair[0]{
+ "--session" if sid.is_none()=>sid=Some(pair[1]),
+ "--server" if server.is_none()=>server=Some(pair[1]),
+ "--pane" if pane.is_none()=>pane=Some(pair[1]),
+ "--mode" if mode.is_none()=>mode=Some(pair[1]),
+ "--file" if file.is_none()=>file=Some(PathBuf::from(pair[1])),
+ _=>return None}}
+ let(pid,birth)=server?.split_once(':')?;let expected=Identity::parse(sid?,pid,birth)?;
+ let mode=Mode::parse(mode?)?;let pane=pane_id(pane?)?;
+ if matches!(mode,Mode::CodexClear|Mode::CopyCancel){if file.is_some(){return None}}else if !file.as_ref()?.is_absolute(){return None}
+ Some(Invocation{expected,pane,mode,file})
+}
+fn validate(r:&Request)->io::Result<()>{
+ if r.expected.pid==0||r.expected.birth==0{return Err(invalid())}
+ match(&r.mode,&r.payload){
+ (Mode::Keys,Payload::Keys(keys))if keys.len()<=4096&&keys.iter().all(|k|k.len()<=4096)&&keys.iter().map(String::len).sum::<usize>()<=MAX_FILE=>{},
+ (Mode::CodexClear|Mode::CopyCancel,Payload::None)=>{},
+ (Mode::Raw|Mode::Bracketed|Mode::Codex|Mode::Auto,Payload::Text(s))if s.len()<=MAX_FILE=>{},
+ _=>return Err(invalid())}Ok(())
+}
+fn decode_payload(mode:Mode,bytes:&[u8])->io::Result<Payload>{
+ if bytes.len()>MAX_FILE{return Err(invalid())}
+ if mode==Mode::Keys{Ok(Payload::Keys(serde_json::from_slice::<Vec<String>>(bytes).map_err(|_|invalid())?))}
+ else{Ok(Payload::Text(String::from_utf8(bytes.to_vec()).map_err(|_|invalid())?))}
+}
+pub(crate) fn load(i:Invocation)->io::Result<Request>{
+ let payload=if matches!(i.mode,Mode::CodexClear|Mode::CopyCancel){Payload::None}else{
+  let file=std::fs::File::open(i.file.ok_or_else(invalid)?)?;let mut bytes=Vec::new();file.take(MAX_FILE as u64+1).read_to_end(&mut bytes)?;decode_payload(i.mode,&bytes)?};
+ let r=Request{expected:i.expected,pane:i.pane,mode:i.mode,payload};validate(&r)?;Ok(r)
+}
+#[derive(serde::Serialize,serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Wire{session:String,server:String,pane:String,mode:String,payload:serde_json::Value}
+pub(crate) fn wire(r:&Request)->io::Result<String>{
+ validate(r)?;
+ let payload=match &r.payload{Payload::Text(s)=>serde_json::json!(s),Payload::Keys(k)=>serde_json::json!(k),Payload::None=>serde_json::Value::Null};
+ let bytes=serde_json::to_vec(&Wire{session:r.expected.sid.to_string(),server:format!("{}:{}",r.expected.pid,r.expected.birth),pane:format!("%{}",r.pane),mode:r.mode.name().into(),payload}).map_err(|_|invalid())?;
+ let value=base64::engine::general_purpose::STANDARD.encode(bytes);if value.len()>MAX_WIRE{return Err(invalid())}Ok(value)
+}
+pub(crate) fn parse_wire(s:&str)->io::Result<Request>{
+ if s.len()>MAX_WIRE{return Err(invalid())}
+ let bytes=base64::engine::general_purpose::STANDARD.decode(s).map_err(|_|invalid())?;
+ let w:Wire=serde_json::from_slice(&bytes).map_err(|_|invalid())?;
+ let(pid,birth)=w.server.split_once(':').ok_or_else(invalid)?;
+ let expected=Identity::parse(&w.session,pid,birth).ok_or_else(invalid)?;
+ let mode=Mode::parse(&w.mode).ok_or_else(invalid)?;let pane=pane_id(&w.pane).ok_or_else(invalid)?;
+ let payload=match mode{
+ Mode::CodexClear|Mode::CopyCancel if w.payload.is_null()=>Payload::None,
+ Mode::Keys=>Payload::Keys(serde_json::from_value(w.payload).map_err(|_|invalid())?),
+ Mode::Raw|Mode::Bracketed|Mode::Codex|Mode::Auto=>Payload::Text(w.payload.as_str().ok_or_else(invalid)?.to_string()),
+ _=>return Err(invalid())};
+ let r=Request{expected,pane,mode,payload};validate(&r)?;Ok(r)
+}
+pub(crate) fn auto_mode(command:&str)->Mode{
+ // OSC may supply a quoted command line or an executable-only path with spaces.
+ // Reuse the vendor Windows-aware tokenizer for command lines; do not split a
+ // complete unquoted .exe path merely because its directory contains spaces.
+ let command=command.trim();
+ let parsed=crate::commands::parse_command_line(command);
+ let whole_executable=!command.starts_with(['\"','\'']) && command.to_ascii_lowercase().ends_with(".exe");
+ let token=if whole_executable{command}else{parsed.first().map(String::as_str).unwrap_or("")};
+ let name=token.rsplit(['\\','/']).next().unwrap_or("").to_ascii_lowercase();
+ match name.strip_suffix(".exe").unwrap_or(&name){"pwsh"|"powershell"=>Mode::Raw,"codex"|"codex-code-mode-host"=>Mode::Codex,_=>Mode::Bracketed}
+}
+pub(crate) struct Encoded{pub bytes:Vec<u8>,pub win32:bool}
+pub(crate) fn encode(r:&Request,command:&str)->io::Result<Encoded>{
+ validate(r)?;let mode=if r.mode==Mode::Auto{auto_mode(command)}else{r.mode};let mut bytes=Vec::new();let mut win32=false;
+ match(mode,&r.payload){
+ (Mode::Raw,Payload::Text(s))=>bytes.extend_from_slice(s.as_bytes()),
+ (Mode::Bracketed,Payload::Text(s))=>{bytes.extend_from_slice(b"\x1b[200~");bytes.extend_from_slice(s.as_bytes());bytes.extend_from_slice(b"\x1b[201~");},
+ (Mode::Codex,Payload::Text(s))=>{win32=true;for c in s.encode_utf16(){let(vk,uc,ctrl)=if c==10{(13,13,16)}else{(0,c,0)};bytes.extend_from_slice(crate::input::win32_input_key_seq(vk,0,uc,ctrl).as_bytes());if bytes.len()>MAX_ENCODED{return Err(invalid())}}},
+ (Mode::CodexClear,Payload::None)=>{win32=true;bytes.extend_from_slice(crate::input::win32_input_key_seq(85,0,21,8).as_bytes());},
+ (Mode::Keys,Payload::Keys(keys))=>{
+  use crossterm::event::{KeyCode,KeyEvent,KeyModifiers};
+  for key in keys{
+   if let Some((code,mods))=if key.trim()==key {crate::config::parse_key_string(key)}else{None}{
+    if let KeyCode::Char(c)=code{if c.is_ascii_alphabetic()&&mods==KeyModifiers::CONTROL{win32=true;let uc=crate::input::ctrl_char_send_keys_byte(c).ok_or_else(invalid)?;bytes.extend_from_slice(crate::input::win32_input_key_seq(c.to_ascii_uppercase()as u16,0,uc as u16,8).as_bytes());continue;}}
+    let encoded=crate::input::encode_key_event(&KeyEvent::new(code,mods)).ok_or_else(invalid)?;bytes.extend_from_slice(&encoded);
+   }else{bytes.extend_from_slice(key.as_bytes());}
+   if bytes.len()>MAX_ENCODED{return Err(invalid())}
+  }},
+ (Mode::CopyCancel,Payload::None)=>{},
+ _=>return Err(invalid())}
+ if bytes.len()>MAX_ENCODED{return Err(invalid())}Ok(Encoded{bytes,win32})
+}
+fn selected_pane(app:&mut crate::types::AppState,id:usize)->Option<&mut crate::types::Pane>{
+ fn walk(node:&mut crate::types::Node,id:usize)->Option<&mut crate::types::Pane>{match node{crate::types::Node::Leaf(p)if p.id==id=>Some(p),crate::types::Node::Split{children,..}=>children.iter_mut().find_map(|n|walk(n,id)),_=>None}}
+ for w in &mut app.windows{if let Some(p)=walk(&mut w.root,id){return Some(p)}for f in &mut w.floating{if f.pane.id==id{return Some(&mut f.pane)}}}None
+}
+fn pane_command(p:&crate::types::Pane)->String{
+ if let Ok(parser)=p.term.lock(){if let Some(cmd)=parser.screen().shell_command(){return cmd.to_string()}}
+ p.child_pid.and_then(crate::platform::process_info::get_deepest_foreground_process_name_fresh).unwrap_or_default()
+}
+pub(crate) fn apply<W:Write>(app:&mut crate::types::AppState,r:&Request,reply:&mut W,birth:impl FnOnce(u32)->Option<u64>)->io::Result<()>{
+ let pid=std::process::id();let actual=birth(pid).filter(|b|*b!=0).map(|birth|Identity{sid:app.session_id,pid,birth});
+ if actual!=Some(r.expected)||validate(r).is_err(){reply.write_all(REJECTED)?;return reply.flush()}
