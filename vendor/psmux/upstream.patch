+++ b/tests-rs/test_checked_stop_handler.rs
@@ -0,0 +1,71 @@
+// Real authenticated one-shot connection handler. No server/provider process,
+// registry files or lifecycle effects; the actor request and socket are observed.
+use super::*;
+use std::io::{Read, Write};
+use std::net::{Shutdown, TcpListener, TcpStream};
+use std::sync::{mpsc, Arc, RwLock};
+use crate::types::CtrlReq;
+
+fn exchange(line: &str, accept: bool, alias: bool) -> (usize, String) {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let mut client = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+    client.set_read_timeout(Some(Duration::from_secs(2))).unwrap();
+    let (server, _) = listener.accept().unwrap();
+    let (tx, rx) = mpsc::channel();
+    let mut aliases = std::collections::HashMap::new();
+    if alias {
+        aliases.insert("kill-session-checked".into(), "kill-session".into());
+        aliases.insert("list-panes-checked".into(), "kill-session".into());
+    }
+    let handler = std::thread::spawn(move || crate::server::connection::handle_connection(
+        server, tx, "public-synthetic-key", Arc::new(RwLock::new(aliases))));
+    write!(client, "AUTH public-synthetic-key\nTARGET =sibling\n{}\n", line).unwrap();
+    client.flush().unwrap(); client.shutdown(Shutdown::Write).unwrap();
+    let mut requests = 0;
+    while let Ok(req) = rx.recv_timeout(Duration::from_millis(200)) {
+        match req {
+            CtrlReq::CheckedKillSession(expected, mut reply) => {
+                requests += 1;
+                assert_eq!(expected, crate::checked_stop::Identity { sid: 7, pid: 10, birth: 11 });
+                // Exercise the exact actor result writer/order, with synthetic
+                // identity/effect. Separate AppState tests cover actor dispatch.
+                let actual = accept.then_some(expected);
+                crate::checked_stop::perform(expected, actual, &mut reply, || {}).unwrap();
+                reply.shutdown(Shutdown::Write).unwrap();
+            }
+            CtrlReq::ListAllPanesFormat(reply, fmt) => {
+                requests += 1; assert_eq!(fmt, crate::checked_stop::PANE_FORMAT);
+                reply.send("own|$7|10|11|%1|0|/inert|80|24|1".into()).unwrap();
+            }
+            CtrlReq::ClientActivity(_) => {},
+            _ => panic!("checked command forwarded, focused or enqueued an unchecked effect"),
+        }
+    }
+    handler.join().unwrap();
+    let mut output = String::new(); client.read_to_string(&mut output).unwrap();
+    (requests, output)
+}
+#[test]
+fn checked_handler_preserves_expectation_ignores_alias_and_never_forwards_target() {
+    let (count, result) = exchange("kill-session-checked 7 10 11", true, true);
+    assert_eq!(count, 1); assert_eq!(result, "OK\nCHECKED-STOP COMPLETE\n");
+}
+#[test]
+fn checked_handler_propagates_actor_rejection_not_enqueue_ack() {
+    let (count, result) = exchange("kill-session-checked 7 10 11", false, false);
+    assert_eq!(count, 1); assert_eq!(result, "OK\nCHECKED-STOP REJECTED\n");
+}
+#[test]
+fn malformed_checked_handler_dispatches_nothing() {
+    for line in ["kill-session-checked 7 10 0", "kill-session-checked 7 10", "kill-session-checked 7 10 11 extra",
+        "kill-session-checked 7 10 11 ; kill-session"] {
+        let (count, result) = exchange(line, true, false);
+        assert_eq!(count, 0); assert_eq!(result, "OK\nCHECKED-STOP REJECTED\n");
+    }
+}
+
+#[test]
+fn checked_observation_ignores_alias_and_sibling_target_without_mutation() {
+    let (count, result) = exchange("list-panes-checked", true, true);
+    assert_eq!(count, 1); assert_eq!(result, "OK\nown|$7|10|11|%1|0|/inert|80|24|1\n");
+}
diff --git a/tests-rs/test_targetless_kill_session_self.rs b/tests-rs/test_targetless_kill_session_self.rs
new file mode 100644
--- /dev/null
+++ b/tests-rs/test_targetless_kill_session_self.rs
@@ -0,0 +1,173 @@
+// OpenRig Windows qualification regression source, based on psmux3.4.0
+// 20aa1d7254ee93f64dafa059ef89341d9767470a. Not yet compiled or executed.
+// Raw-target registry-decoy handler fixture, not ordinary default-namespace discovery.
+// Delimiter labels preserve exact spelling through the pinned Unix path comparator.
+// Exercises the real one-shot handler; CtrlReq replies emulate the selected server.
+// Only synthetic loopback peers/private registry files, no psmux/provider process.
+use super::*;
+use std::net::{Shutdown, TcpListener, TcpStream};
+use std::io::{Read, Write};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, RwLock};
+
+struct Registry {
+    root: std::path::PathBuf,
+    previous: Option<std::ffi::OsString>,
+}
+impl Registry {
+    fn new() -> Self {
+        let suffix = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();
+        let root = std::env::temp_dir().join(format!("psmux-self-test-{}-{suffix}", std::process::id()));
+        std::fs::create_dir(&root).unwrap();
+        // The vendor's Windows path helpers use backslashes even on Linux.
+        // Nest the data root so either separator interpretation stays under
+        // our owned outer root; always publish via the actual vendor helpers.
+        let data = root.join("registry");
+        std::fs::create_dir(&data).unwrap();
+        let previous = std::env::var_os("PSMUX_DATA_DIR");
+        std::env::set_var("PSMUX_DATA_DIR", &data);
+        for name in ["ns__case__same", "case__same", "case__other", "case__missing"] {
+            assert_registry_absent(name);
+        }
+        Self { root, previous }
+    }
+    fn publish(&self, name: &str, listener: &TcpListener) {
+        publish_registry(name, listener.local_addr().unwrap().port());
+    }
+}
+impl Drop for Registry {
+    fn drop(&mut self) {
+        if let Some(value) = &self.previous { std::env::set_var("PSMUX_DATA_DIR", value); }
+        else { std::env::remove_var("PSMUX_DATA_DIR"); }
+        let _ = std::fs::remove_dir_all(&self.root);
+    }
+}
+
+fn assert_registry_absent(name: &str) {
+    assert!(!std::path::Path::new(&crate::paths::port_file(name)).exists());
+    assert!(!std::path::Path::new(&crate::paths::key_file(name)).exists());
+}
+fn publish_registry(name: &str, port: u16) {
+    let port_file = crate::paths::port_file(name);
+    let key_file = crate::paths::key_file(name);
+    let port_bytes = port.to_string();
+    std::fs::write(&port_file, &port_bytes).unwrap();
+    std::fs::write(&key_file, "synthetic-public-test-key").unwrap();
+    assert_eq!(std::fs::read_to_string(&port_file).unwrap(), port_bytes);
+    assert_eq!(std::fs::read_to_string(&key_file).unwrap(), "synthetic-public-test-key");
+    assert_eq!(crate::session::registry_case_variant(name), None);
+}
+
+// after_predicate executes while replying to the handler's actual -F query,
+// so a registry replacement really occurs between predicate and kill dispatch.
+fn exchange(command: &str, condition: Option<bool>, after_predicate: impl FnOnce() + Send + 'static)
+    -> (usize, usize, String)
+{
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    publish_registry("ns__case__same", listener.local_addr().unwrap().port());
+    let mut client = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+    client.set_read_timeout(Some(Duration::from_secs(2))).unwrap();
+    let (server, _) = listener.accept().unwrap();
+    let (sender, receiver) = mpsc::channel();
+    let kills = Arc::new(AtomicUsize::new(0));
+    let name_queries = Arc::new(AtomicUsize::new(0));
+    let kill_count = kills.clone(); let query_count = name_queries.clone();
+    let replies = std::thread::spawn(move || {
+        let mut hook = Some(after_predicate);
+        while let Ok(request) = receiver.recv_timeout(Duration::from_secs(3)) {
+            match request {
+                CtrlReq::DisplayMessage(reply, format, ..) => {
+                    let value = if format.starts_with("#{==:") {
+                        if let Some(action) = hook.take() { action(); }
+                        match condition {
+                            Some(true) => "1".to_string(), Some(false) => "0".to_string(),
+                            None => continue, // dropped expansion reply is unknown, never true
+                        }
+                    } else { format };
+                    let _ = reply.send(value);
+                }
+                CtrlReq::SessionInfo(reply) => {
+                    query_count.fetch_add(1, Ordering::SeqCst);
+                    let _ = reply.send("case__same:1".to_string());
+                }
+                CtrlReq::KillSession => { kill_count.fetch_add(1, Ordering::SeqCst); }
+                _ => panic!("Unexpected request; extend fixture explicitly, never report success"),
+            }
+        }
+    });
+    let aliases = Arc::new(RwLock::new(std::collections::HashMap::new()));
+    let handler = std::thread::spawn(move || handle_connection(server, sender, "synthetic-public-test-key", aliases));
+    write!(client, "AUTH synthetic-public-test-key\nTARGET =case__same\n{command}\n").unwrap();
+    client.shutdown(Shutdown::Write).unwrap();
+    let mut output = String::new(); client.read_to_string(&mut output).unwrap();
+    handler.join().unwrap(); replies.join().unwrap();
+    (kills.load(Ordering::SeqCst), name_queries.load(Ordering::SeqCst), output)
+}
+fn forwarded(listener: &TcpListener) -> bool {
+    listener.set_nonblocking(true).unwrap();
+    match listener.accept() {
+        Ok((mut peer, _)) => {
+            peer.set_read_timeout(Some(Duration::from_millis(500))).unwrap();
+            let mut bytes = String::new(); peer.read_to_string(&mut bytes).unwrap();
+            assert_eq!(bytes, "AUTH synthetic-public-test-key\nkill-session\n");
+            true
+        }
+        Err(error) if error.kind() == io::ErrorKind::WouldBlock => false,
+        Err(error) => panic!("Synthetic peer failed: {error}"),
+    }
+}
+
+#[test]
+fn inherited_target_cannot_forward_to_same_default_name() {
+    let _lock = crate::util::lock_test_env(); let registry = Registry::new();
+    let decoy = TcpListener::bind("127.0.0.1:0").unwrap(); registry.publish("case__same", &decoy);
+    let (kills, queries, _) = exchange("if-shell -F '#{==:#{session_id},$7}' 'kill-session' 'display-message -p kept'", Some(true), || {});
+    assert_eq!((kills, queries), (1, 0)); assert!(!forwarded(&decoy));
+}
+#[test]
+fn registry_replacement_after_predicate_cannot_redirect_kill() {
+    let _lock = crate::util::lock_test_env(); let registry = Registry::new();
+    let replacement = TcpListener::bind("127.0.0.1:0").unwrap();
+    assert_registry_absent("case__same");
+    let port = replacement.local_addr().unwrap().port();
+    let (kills, queries, _) = exchange("if-shell -F '#{==:#{session_id},$7}' 'kill-session' 'display-message -p kept'", Some(true), move || {
+        publish_registry("case__same", port);
+    });
+    assert_eq!((kills, queries), (1, 0)); assert!(!forwarded(&replacement));
+}
+#[test]
+fn explicit_other_target_still_forwards() {
+    let _lock = crate::util::lock_test_env(); let registry = Registry::new();
+    let other = TcpListener::bind("127.0.0.1:0").unwrap(); registry.publish("case__other", &other);
+    let (kills, _, _) = exchange("kill-session -t =case__other", Some(true), || {});
+    assert_eq!(kills, 0); assert!(forwarded(&other));
+}
+#[test]
+fn stripped_top_level_target_kills_selected_connection() {
+    // CLI selection/stripping is covered by the paired main.rs regression.
+    let _lock = crate::util::lock_test_env(); let _registry = Registry::new();
+    let (kills, queries, _) = exchange("kill-session", Some(true), || {});
+    assert_eq!((kills, queries), (1, 0));
+}
+#[test]
+fn false_condition_never_kills() {
+    let _lock = crate::util::lock_test_env(); let _registry = Registry::new();
+    assert_eq!(exchange("if-shell -F '#{==:#{session_id},$7}' 'kill-session' 'display-message -p kept'", Some(false), || {}).0, 0);
+}
+#[test]
+fn missing_explicit_target_fails_before_destruction() {
+    let _lock = crate::util::lock_test_env(); let _registry = Registry::new();
+    let (kills, _, output) = exchange("kill-session -t", Some(true), || {});
+    assert_eq!(kills, 0); assert!(output.contains("ERROR:"));
+}
+
+#[test]
+fn dropped_predicate_reply_never_kills() {
+    let _lock = crate::util::lock_test_env(); let _registry = Registry::new();
+    assert_eq!(exchange("if-shell -F '#{==:#{session_id},$7}' 'kill-session' 'display-message -p kept'", None, || {}).0, 0);
+}
+#[test]
+fn unresolved_explicit_other_target_never_kills_self() {
+    let _lock = crate::util::lock_test_env(); let _registry = Registry::new();
+    assert_eq!(exchange("kill-session -t =case__missing", Some(true), || {}).0, 0);
+}
