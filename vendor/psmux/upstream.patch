+use super::*;
+
+fn request() -> Request {
+    Request { version: 1, attempt: "818bff4a-3ffd-4ddb-9aed-a46593c141a8".into(), name: "seat@rig".into(), cwd: std::env::temp_dir().to_string_lossy().into(), env: Default::default(), unset: vec![] }
