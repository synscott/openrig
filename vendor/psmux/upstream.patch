+    #[test]
+    fn cli_preserves_expected_sid_and_rejects_name_or_combined_modes() {
+        assert_eq!(parse_cli(&["-t", "$7", "-G", "10:11"]), Some(original()));
+        assert_eq!(parse_cli(&["-G", "10:11", "-t", "$7"]), Some(original()));
+        for tail in [vec!["-t", "replacement", "-G", "10:11"],
+            vec!["-t", "$7", "-G10:11"], vec!["-t", "$7", "-G", "10:11", "-a"],
+            vec!["-G", "10:11", "-G", "10:11"]] { assert!(parse_cli(&tail).is_none()); }
+    }
+    #[test]
+    fn rejected_incarnations_have_zero_effects() {
+        for actual in [None, Some(Identity { sid: 8, ..original() }),
+            Some(Identity { pid: 12, ..original() }), Some(Identity { birth: 12, ..original() })] {
+            let effects = Cell::new(0); let mut out = Vec::new();
+            assert!(!perform(original(), actual, &mut out, || effects.set(1)).unwrap());
+            assert_eq!(effects.get(), 0); assert_eq!(out, REJECTED);
+        }
+    }
+    #[test]
+    fn completion_is_written_and_flushed_after_effect() {
+        struct Writer<'a>(&'a Cell<u8>, Vec<u8>);
+        impl Write for Writer<'_> {
+            fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+                assert_eq!(self.0.get(), 1); self.1.extend(bytes); Ok(bytes.len())
+            }
+            fn flush(&mut self) -> io::Result<()> { assert_eq!(self.1, COMPLETE); self.0.set(2); Ok(()) }
+        }
+        let phase = Cell::new(0); let mut out = Writer(&phase, Vec::new());
+        assert!(perform(original(), Some(original()), &mut out, || phase.set(1)).unwrap());
+        assert_eq!(phase.get(), 2);
+    }
+    #[test]
+    fn fixed_numeric_identity_refuses_zero_birth_and_invalid_types() {
+        for (sid, pid, birth) in [("7", "0", "11"), ("7", "10", "0"),
+            ("$7", "10", "11"), ("7", "+10", "11"), ("7", "10", ""), ("7", "10", "18446744073709551616")] {
+            assert!(Identity::parse(sid, pid, birth).is_none());
+        }
+        assert_eq!(Identity::parse("7", "10", "11"), Some(original()));
+    }
+    #[test]
+    fn only_exact_complete_reply_is_success() {
+        for bytes in [b"".as_slice(), b"OK\n", COMPLETE, b"OK\nCHECKED-STOP COMPLE", b"OK\nCHECKED-STOP COMPLETE\nextra", b"OK\nCHECKED-STOP REJECTED\n"] {
+            assert!(read_result(&mut &bytes[..]).is_err());
+        }
+        assert!(read_result(&mut &b"OK\nCHECKED-STOP COMPLETE\n"[..]).is_ok());
+    }
+    #[test]
+    fn read_failure_after_complete_bytes_is_unknown() {
+        struct Broken(bool, io::ErrorKind);
+        impl Read for Broken {
+            fn read(&mut self, out: &mut [u8]) -> io::Result<usize> {
+                if self.0 { return Err(self.1.into()); }
+                self.0 = true; let bytes = b"OK\nCHECKED-STOP COMPLETE\n";
+                out[..bytes.len()].copy_from_slice(bytes); Ok(bytes.len())
+            }
+        }
+        for kind in [io::ErrorKind::ConnectionReset, io::ErrorKind::TimedOut, io::ErrorKind::WouldBlock] {
+            assert!(read_result(&mut Broken(false, kind)).is_err());
+        }
+    }
+    #[test]
+    fn failed_flush_never_reports_completed() {
+        struct Broken;
+        impl Write for Broken {
+            fn write(&mut self, bytes: &[u8]) -> io::Result<usize> { Ok(bytes.len()) }
+            fn flush(&mut self) -> io::Result<()> { Err(io::ErrorKind::BrokenPipe.into()) }
+        }
+        assert!(perform(original(), Some(original()), &mut Broken, || {}).is_err());
+    }
