+        let expected = Identity::own(7).map(|i| i.birth.to_string()).unwrap_or_default();
+        assert_eq!(crate::format::expand_format("#{session_id}|#{server_pid}|#{server_birth}", &app),
+            format!("$7|{}|{}", std::process::id(), expected));
