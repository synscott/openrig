+    }
+    #[test]
+    fn read_failure_after_complete_bytes_is_unknown() {
+        struct Broken(bool, io::ErrorKind);
+        impl Read for Broken {
+            fn read(&mut self, out: &mut [u8]) -> io::Result<usize> {
+                if self.0 { return Err(self.1.into()); }
+                self.0 = true; let bytes = b"OK\nCHECKED-STOP COMPLETE\n";
+                out[..bytes.len()].copy_from_slice(bytes); Ok(bytes.len())
+            }
+        }
+        for kind in [io::ErrorKind::ConnectionReset, io::ErrorKind::TimedOut, io::ErrorKind::WouldBlock] {
+            assert!(read_result(&mut Broken(false, kind)).is_err());
+        }
+    }
+    #[test]
+    fn failed_flush_never_reports_completed() {
+        struct Broken;
+        impl Write for Broken {
+            fn write(&mut self, bytes: &[u8]) -> io::Result<usize> { Ok(bytes.len()) }
+            fn flush(&mut self) -> io::Result<()> { Err(io::ErrorKind::BrokenPipe.into()) }
+        }
+        assert!(perform(original(), Some(original()), &mut Broken, || {}).is_err());
+    }
